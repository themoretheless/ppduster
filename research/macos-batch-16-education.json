      "platform": "macos",
      "risk": "medium",
      "default_enabled": false,
      "min_age_days": 14,
      "report_only": false,
      "delete_mode": "contents",
      "max_depth": 6,
      "paths": [
        "$HOME/Library/Application Support/AnkiProgramFiles/cache",
        "$HOME/Library/Application Support/AnkiProgramFiles/.cache"
