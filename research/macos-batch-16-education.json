{
  "batch": "16-education",
  "platform": "macos",
  "title": "macOS education and learning app caches",
  "description": "Regenerable caches, Electron Chromium subdirs, logs, and residual temps for education/learning apps under $HOME. Never note libraries, flashcard collections, course offline downloads treated as libraries, citation databases, e-book content folders, or vaults. Obsidian Electron caches are covered in batches 05/07 and deliberately omitted here.",
  "safety_notes": [
    "Anki: clean only Caches/, launcher download cache, and AnkiProgramFiles package cache. Never Anki2 profile collections (collection.anki2, collection.media, backups).",
    "Zotero/Mendeley/Papers/ReadCube: clean app Caches and Chromium/PDF render caches only. Never $HOME/Zotero storage, Mendeley Desktop database, or Papers library roots.",
    "Kindle: container Library/Caches and app Caches only. Never My Kindle Content, Documents book trees, or container Documents content folders (library report only).",
    "Apple Books: residual Caches/Logs under iBooksX containers only. Never BKLibrary databases as wipe targets for content; never Mobile Documents iCloud book packages.",
    "GoodNotes/Notability/LiquidText/PDF Expert/GoodReader: sandbox Library/Caches and named Caches bundles only. Never Documents note libraries or user PDFs inside containers.",
    "MATLAB/Mathematica/Octave/Wolfram: download/tool/paclet caches and Caches/Wolfram. Prefer contents-only; do not wipe prefdir settings wholesale or licensed install roots under /Applications.",
    "Language and MOOC Electron apps: Cache/Code Cache/GPUCache/Dawn*/blob_storage/Crashpad/logs only. Leave Local Storage, IndexedDB, Cookies, Preferences, and offline course material stores when separate from Chromium cache dirs.",
    "Obsidian residual: skip (covered in macos-batch-05-comms and macos-batch-07-office-electron)."
  ],
  "risk_policy": {
    "chromium_electron_caches": "low",
    "app_library_caches_containers": "low",
    "launcher_package_download_caches": "medium (large re-download)",
    "citation_pdf_render_caches": "low to medium",
    "ebook_content_and_note_libraries": "report-only or excluded",
    "math_paclet_and_support_package_caches": "medium",
    "credentials_and_preferences": "never-touch (excluded)"
  },
  "sources": [
    "Anki docs file locations (Anki2 under Application Support); Anki forums for net.ankiweb.dtop / net.ankiweb.launcher and AnkiProgramFiles + uv cache",
    "Zotero forums: ~/Library/Caches/Zotero safe to delete; data dir $HOME/Zotero storage excluded",
    "Wolfram support uninstall/reset: ~/Library/Caches/Wolfram",
    "MathWorks prefdir docs: ~/Library/Application Support/MathWorks/MATLAB/R* (prefs not bulk-wiped; separate cache/download paths only)",
    "Fleet PDF Expert darwin catalog: com.readdle.PDFExpert-Mac Caches paths",
    "GoodNotes community: com.goodnotesapp.x container Library/Caches",
    "Notability Ginger Labs: com.gingerlabs.Notability (Mac Catalyst)",
    "Kindle crash-fix guides: com.amazon.Kindle Containers .../Library/Caches",
    "Mendeley Desktop bundle com.mendeley.desktop; ReadCube Papers com.readcube.Papers",
    "GeoGebra: org.geogebra.mac uninstall leftovers"
  ],
  "path_count": 243,
  "rules": [
    {
      "id": "edu-anki-app-caches",
      "name": "Anki app and launcher caches",
      "description": "Anki Qt/desktop Caches bundles and ShipIt-style leftovers; not decks.",
      "category": "app-cache",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "min_age_days": 7,
      "report_only": false,
      "delete_mode": "contents",
      "max_depth": 5,
      "paths": [
        "$HOME/Library/Caches/net.ankiweb.dtop",
        "$HOME/Library/Caches/net.ankiweb.launcher",
        "$HOME/Library/Caches/net.ankiweb.Anki",
        "$HOME/Library/Caches/Anki",
        "$HOME/Library/Logs/Anki"
      ],
      "notes": "Bundle IDs net.ankiweb.dtop (classic) and net.ankiweb.launcher (current). Regenerates on launch. Never Anki2 collections."
    },
    {
      "id": "edu-anki-programfiles-cache",
      "name": "AnkiProgramFiles package/download cache",
      "description": "Launcher uv/package download cache under AnkiProgramFiles; reinstallable.",
