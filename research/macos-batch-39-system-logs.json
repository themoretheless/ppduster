{
  "batch": "39-system-logs",
  "platform": "macos",
  "title": "User-scoped diagnostic logs beyond basic CrashReporter",
  "description": "Deep user-writable diagnostic and system-log residual paths under $HOME and user temp: DiagnosticReports typed deeper (hang/spin/GPURestart/jetsam/sample/cpu_resource/watchdog), logarchives, sysdiagnose leftovers in TMPDIR and user-owned /var/tmp, spindump/sample/hang report globs, power/thermal residual (PPM/homeenergyd/HomeEnergy DE), wifi/bluetooth/usb diagnostic extensions, Disk Utility and fsck leftovers, install.log DE, softwareupdated user caches/HTTPStorages, App Store residual logs/caches, System Settings menu/preference-pane caches, Control Center caches, Notification Center DB residual (report-only/medium), Dock residual caches, menu bar extras caches. USER writable only. Never system /Library/Logs roots, never Preferences plists that hold settings, never Keychains/Documents/Desktop/Downloads.",
  "safety_notes": [
    "USER writable only: $HOME/Library/**, $TMPDIR, and user-owned files under /var/tmp and /private/var/tmp. Do not target /Library/Logs/DiagnosticReports or /private/var/log without elevation (out of pack).",
    "Never delete Preferences plists (Dock layout, Control Center tiles, WiFi known networks, SoftwareUpdate settings). Caches/Logs/HTTPStorages only.",
    "Notification Center and UserNotifications stores are report-only or medium: may clear pending notification state; not default_enabled.",
    "sysdiagnose and .logarchive can be multi-GB; age gate (14d+) and contents-only.",
    "DiagnosticExtensions containers: only Data/Library/Caches, Logs, tmp, HTTPStorages. Never wipe whole container roots.",
    "Do not touch LaunchAgents/LaunchDaemons plists. Do not touch Keychains, Mail, Messages, or Mobile Documents.",
    "path_count counts distinct path templates across rules (including report-only)."
  ],
  "risk_policy": {
    "diagnostic_reports_typed_aged": "low",
    "sysdiagnose_logarchive_aged": "low (large; age gate)",
    "tmpdir_sysdiagnose": "low to medium (user-owned only)",
    "diagnostic_extensions_caches_logs": "low",
    "softwareupdate_httpstorages_caches": "low",
    "appstore_systemsettings_controlcenter_caches": "low",
    "power_thermal_ppm_homeenergy": "low",
    "wifi_bluetooth_usb_de_residual": "low",
    "diskimages_fsck_leftovers": "low",
    "notification_center_db": "report-only or medium",
    "dock_layout_preferences": "never-touch (excluded)",
    "system_library_logs": "out of scope (not user-writable)"
  },
  "sources": [
    "Live host ~/Library/Logs (DiagnosticReports, CrashReporter/DiagnosticLogs, CrashReporter/MobileDevice, fsck_hfs.log, DiscRecording.log, AppAnalytics, Baseband, Sync, Time, Assistant, PrivacyPreservingMeasurement, com.apple.CloudTelemetry)",
    "Live DiagnosticReports file naming and system-side .diag/.cpu_resource.diag patterns (user scope globs mirror system types)",
    "Apple Console guide: .ips crash, .spin spin, .diag/.dpsub diagnostic reports",
    "sysdiagnose default dump: /var/tmp and $TMPDIR; system_logs.logarchive inside archives (eclecticlight / derflounder)",
    "Live Containers: com.apple.DiagnosticExtensions.*, com.apple.diagnosticextensions.osx.*, WiFiVelocity, NetworkInfo, DiskSpaceDiagnostics, osanalytics.IPSExtension, dock.controls, notificationcenterui, systempreferences, AppStore, wifi-settings-extension, BluetoothSettings",
    "Live Group Containers: group.com.apple.controlcenter, group.com.apple.UserNotifications, group.com.apple.feedbacklogger, com.apple.systempreferences.cache, group.com.apple.appstoreagent, group.com.apple.storekit, group.com.apple.secure-control-center-preferences",
    "Live Caches: com.apple.systemsettings.menucache, preferencepanes.usercache, feedbacklogger, cache_delete, appstore*, commerce, storekitagent, FileProviderDaemon.AppStoreService",
    "Live Application Support: CrashReporter, DiskImages/com.apple.diskimages.fsck, com.apple.controlcenter",
    "Live HTTPStorages: softwareupdate, SoftwareUpdateNotificationManager, appstoreagent, appstorecomponentsd, storekitagent",
    "Live /private/var/tmp/SoftwareUpdateCore (user-owned EventReporterPersistedState)",
    "Live Library top-level: PPM, homeenergyd, com.apple.bluetoothuser, com.apple.bluetooth.services.cloud, Caches/CloudKit/com.apple.bluetoothuserd",
    "Overlap awareness: batch-01 apple-system-logs-extra, crashreporter-app-support; batch-10 diagnostic-reports/sysdiagnose/logarchive (this batch goes deeper on typed globs, DE containers, settings/control-center/dock/notification residual)"
  ],
  "path_count": 185,
  "rules": [
    {
      "id": "syslogs-diagnostic-reports-hang-spin",
      "name": "DiagnosticReports hang and spin reports (user)",
      "description": "User hang and spindump-class reports under DiagnosticReports (beyond generic .ips).",
      "category": "logs",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "report_only": false,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Logs/DiagnosticReports",
        "$HOME/Library/Logs/DiagnosticReports/Retired"
      ],
      "include_globs": [
        "**/*.spin",
        "**/*.hang",
        "**/*Hang-*.ips",
        "**/*Hang*.ips",
        "**/*hang*.ips",
        "**/*spin*.ips",
        "**/*spindump*"
      ],
      "exclude_globs": [],
      "delete_mode": "contents",
      "max_depth": 4,
      "notes": "Console Spin Reports use .spin; hang reports appear as .hang or *Hang*.ips. Regenerable diagnostics; age-gated."
    },
    {
      "id": "syslogs-diagnostic-reports-gpu-jetsam-watchdog",
      "name": "DiagnosticReports GPURestart jetsam watchdog resource (user)",
      "description": "GPU restart, jetsam, watchdog, and resource-pressure diagnostic files in user DiagnosticReports.",
      "category": "logs",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "report_only": false,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Logs/DiagnosticReports",
        "$HOME/Library/Logs/DiagnosticReports/Retired"
      ],
      "include_globs": [
        "**/*GPURestart*",
        "**/*gpuRestart*",
        "**/*GpuRestart*",
        "**/*jetsam*",
        "**/*Jetsam*",
        "**/*watchdog*",
        "**/*Watchdog*",
        "**/*cpu_resource*",
        "**/*disk_resource*",
        "**/*memory_resource*",
        "**/*.cpu_resource.diag",
        "**/*.disk_resource.diag",
        "**/*.diag",
        "**/*.dpsub"
      ],
      "exclude_globs": [],
      "delete_mode": "contents",
      "max_depth": 4,
      "notes": "Resource and GPU diagnostic subtypes. System copies often live under /Library/Logs/DiagnosticReports (not user-writable; out of scope)."
    },
    {
      "id": "syslogs-diagnostic-reports-sample",
