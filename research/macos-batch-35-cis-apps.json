        "$HOME/Library/Application Support/Yandex/YandexBrowser/GraphiteDawnCache",
        "$HOME/Library/Application Support/Yandex/YandexBrowser/component_crx_cache",
        "$HOME/Library/Application Support/Yandex/YandexBrowser/Crashpad"
      ],
      "include_globs": [
        "**/Cache/**",
        "**/Code Cache/**",
        "**/GPUCache/**",
        "**/Media Cache/**",
        "**/DawnCache/**",
        "**/DawnGraphiteCache/**",
        "**/DawnWebGPUCache/**",
        "**/ShaderCache/**",
        "**/GrShaderCache/**",
        "**/Service Worker/CacheStorage/**",
        "**/component_crx_cache/**",
        "**/Crashpad/**"
      ],
      "exclude_globs": [
        "**/Cookies*",
