{
  "batch": "35-cis-apps",
  "platform_focus": "macos",
  "description": "CIS/RU desktop app CACHES and LOGS under $HOME (plus a few carefully scoped CryptoPro residual log/tmp leaves). Covers Yandex Browser/Disk/Music/Telemost, VK Messenger and VK Calls, OK.ru residuals, Mail.ru Agent/Cloud, SberJazz/SaluteJazz, TrueConf, MyOffice, R7-Office, Kontur Talk (ktalk), Contour/Kontur residual, CryptoPro residual logs only, Goskey residual careful, 1C caches, Bitrix24, AmoCRM/Kommo desktop residual, Tinkoff Invest residual, Alfa Invest residual. Chromium Electron leaves only (Cache, Code Cache, GPUCache, Dawn*, Service Worker, blob_storage, Crashpad, logs). Never crypto token/key material, certificate stores, synced cloud trees, or login databases.",
  "scope": "Regenerable caches/logs for CIS-region productivity, comms, office, CRM, and investing desktops. Extends batch-02 Yandex Browser and batch-05 ktalk with Disk/Music/Telemost/VK/Mail.ru/SberJazz/TrueConf/MyOffice/R7/Kontur residual/CryptoPro logs/Goskey residual/1C/Bitrix24/AmoCRM/Tinkoff/Alfa. Never wipe /var/opt/cprocsp/keys, /var/opt/cprocsp/users, key containers, Goskey private material, synced Yandex.Disk or Mail Cloud trees, or CRM offline message DBs.",
  "never_touch_notes": [
    "NEVER CryptoPro key containers: /var/opt/cprocsp/keys, /var/opt/cprocsp/users, /etc/opt/cprocsp configs, cert stores, license blobs",
    "NEVER Goskey private keys, secure enclave material, or full app data trees; residual logs only if clearly regenerable",
    "NEVER whole Application Support/Yandex.Disk.2 (sync state); cache subdirs only",
    "NEVER Yandex Browser Cookies/Login Data/Web Data/History/Bookmarks",
    "NEVER Mail.ru Agent/Cloud offline mailboxes or synced file trees under user Documents/Cloud",
    "NEVER Bitrix24 ~/.bxd whole tree wipe (account/workspace data); cache/log leaves only",
    "NEVER 1C configuration/infobase directories under ~/.1cv8 (only explicit cache/temp leaves)",
    "NEVER R7/MyOffice license files (ru.nkt.r7-office/license, MyOffice CRL is ok if aged; licenses stay)",
    "NEVER Kontur/CryptoPro hardware token contents or Rutoken drivers as bulk wipe",
    "NEVER investing app wallets/session secrets; cache/logs residual only"
  ],
  "sources": [
    "Live host: Application Support/YandexMusic (Electron Cache/Code Cache/GPUCache/Dawn*/blob_storage), Caches/ru.yandex.desktop.music, Logs/YandexMusic, yandexmusic-updater",
    "Live host: Application Support/ktalk (Kontur Talk / Telemost family Electron caches, Crashpad, sentry), Logs/ktalk, Preferences kontur.talk",
    "Homebrew cask zap: yandex, yandex-disk, yandex-music, yandextelemost, vk-messenger, vk-calls, bitrix24, kontur-talk",
    "Yandex Browser help: Application Support/Yandex/YandexBrowser caches; brew trash ~/Library/Caches/Yandex + Application Support/Yandex",
    "SberJazz troubleshooting: ~/Library/Application Support/SaluteJazz (and /Library/Application Support/SaluteJazz system residual)",
    "TrueConf support KB: Containers/org.trueconf.client/.../TrueConf/Logs and Crashlogs; Caches/42f94da1.org.trueconf.client",
    "MyOffice admin/delete docs: Application Support/New Cloud Technologies Ltd./MyOffice; MySynchronizer com.ncloudtech.cloudoffice...MySynchronizer",
    "R7-Office install guide: Application Support/ru.nkt.r7-office (license path excluded from clean)",
    "CryptoPro CSP Mac admin guide: keys under /var/opt/cprocsp/keys/<user>; logging via cpconfig -loglevel; system.log residual only",
    "1C admin docs: macOS ~/.1cv8/1C/1cv8 layout; cache/temp leaves only",
    "iboostup uninstall: ru.mail.macagent; TrueConf org.trueconf.client cache id"
  ],
  "path_count": 289,
  "safety": {
    "crypto_tokens_keys": "never-touch",
    "cryptopro_key_stores": "never-touch",
    "goskey_private_material": "never-touch",
    "synced_cloud_trees": "never-touch",
    "browser_login_cookies": "never-touch",
    "crm_message_dbs": "never-touch"
  },
  "rules": [
    {
      "id": "cis-yandex-browser-cache-deep",
      "name": "Yandex Browser Chromium caches (deep leaves)",
      "description": "Yandex Browser HTTP/GPU/code/media/Dawn/Service Worker caches under Application Support and Library/Caches. Extends base macos-yandex-browser-cache with more leaves and channel roots.",
      "category": "browser-cache",
      "platform": "macos",
      "risk": "medium",
      "default_enabled": false,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Caches/Yandex",
        "$HOME/Library/Caches/Yandex/YandexBrowser",
        "$HOME/Library/Caches/ru.yandex.desktop.yandex-browser",
        "$HOME/Library/Application Support/Yandex/YandexBrowser/Default/Cache",
        "$HOME/Library/Application Support/Yandex/YandexBrowser/Default/Code Cache",
        "$HOME/Library/Application Support/Yandex/YandexBrowser/Default/GPUCache",
        "$HOME/Library/Application Support/Yandex/YandexBrowser/Default/Media Cache",
        "$HOME/Library/Application Support/Yandex/YandexBrowser/Default/Service Worker/CacheStorage",
        "$HOME/Library/Application Support/Yandex/YandexBrowser/Default/DawnCache",
        "$HOME/Library/Application Support/Yandex/YandexBrowser/Default/DawnGraphiteCache",
        "$HOME/Library/Application Support/Yandex/YandexBrowser/Default/DawnWebGPUCache",
        "$HOME/Library/Application Support/Yandex/YandexBrowser/ShaderCache",
