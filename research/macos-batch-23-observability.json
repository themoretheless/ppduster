{
  "batch": "23-observability",
  "platform": "macos",
  "description": "macOS monitoring and observability agent logs, desktop app caches, local TSDB/state, and user logarchives. Prefer contents-only deletes, age gates, and never-touch for secrets (API keys, license files, agent conf). Exclude htop. Prometheus local TSDB and Activity Monitor process samples are report-only. Console .logarchive under user Library/Logs or temp is reclaimable when aged; never target Desktop/Documents/Downloads.",
  "path_count": 134,
  "risk_policy": {
    "agent_logs": "low (regenerable diagnostic logs)",
    "agent_run_state_registry": "medium (positions/registry may re-ship logs; safe after stop)",
    "prometheus_tsdb": "report-only (local metrics history)",
    "sentry_cli_config_dir": "report-only (cli.db holds credentials + cache)",
    "desktop_monitor_caches": "low",
    "credentials_license_conf": "never-touch (excluded)",
    "htop": "out of scope (excluded per batch brief)"
  },
  "rules": [
    {
      "id": "obs-datadog-agent-logs",
      "name": "Datadog Agent logs (macOS)",
      "category": "logs",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "report_only": false,
      "min_age_days": 7,
      "delete_mode": "contents",
      "max_depth": 3,
      "paths": [
        "/opt/datadog-agent/logs",
        "/var/log/datadog"
      ],
      "notes": "Official Agent log dirs: v6.28+/v7.28+ use /opt/datadog-agent/logs; older agents use /var/log/datadog. Rollover files agent.log, process-agent.log, trace-agent.log, system-probe.log, dogstatsd.log. Stop agent before mass delete if in use."
    },
    {
      "id": "obs-datadog-agent-run-cache",
      "name": "Datadog Agent run and install temp",
      "category": "cache",
      "platform": "macos",
      "risk": "medium",
      "default_enabled": false,
      "report_only": false,
      "min_age_days": 7,
      "delete_mode": "contents",
      "max_depth": 4,
      "paths": [
        "/opt/datadog-agent/run",
        "/tmp/dd_agent.log"
      ],
      "notes": "Runtime sockets/state under run/; install log at /tmp/dd_agent.log. Do not delete /opt/datadog-agent/etc (config)."
    },
    {
      "id": "obs-datadog-user-sdk-cache",
      "name": "Datadog user Library cache (SDK/agent UI)",
      "category": "cache",
      "platform": "macos",
      "risk": "low",
