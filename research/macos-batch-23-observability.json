        "$HOME/Library/Logs/Datadog",
        "$HOME/Library/Logs/com.datadoghq.agent"
      ],
      "notes": "User-space Datadog caches (e.g. RUM/SDK logging intermediate store under Caches/com.datadoghq/v2/*/logging). Regenerable."
    },
    {
      "id": "obs-newrelic-infra-agent-dir",
      "name": "New Relic infrastructure agent data dir",
      "category": "cache",
      "platform": "macos",
      "risk": "medium",
      "default_enabled": false,
      "report_only": false,
      "min_age_days": 14,
      "delete_mode": "contents",
      "max_depth": 5,
