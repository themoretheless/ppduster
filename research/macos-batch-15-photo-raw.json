{
  "batch": "15-photo-raw",
  "platform": "macos",
  "description": "Regenerable cache/log/temp paths for photo and RAW workflow apps under $HOME beyond Lightroom Classic/cloud and Capture One (already in 04-creative). Covers DxO PhotoLab/PureRAW, Skylum Luminar Neo/AI, ON1 Photo RAW, darktable, RawTherapee, ACDSee, Exposure X, Affinity/Pixelmator residuals, OEM RAW (Nikon NX Studio, Canon DPP, Sony Imaging Edge, Fuji X Raw Studio), Phase One residual, Topaz Photo/Video/Gigapixel/Photo AI, Corel AfterShot. Never .photoslibrary. Catalog DBs, presets, and user edit history are not delete-enabled. Large preview trees and AI model stores are report-only or medium.",
  "never_touch_notes": [
    "$HOME/Pictures/*.photoslibrary and any **/*.photoslibrary/** (never)",
    "Lightroom catalogs (.lrcat) and Previews.lrdata (handled in 04-creative; not re-listed as delete)",
    "Capture One .cocatalog packages and catalog-internal Originals (04-creative report-only only)",
    "DxO PhotoLab Database/ under Application Support (project index; not cache)",
    "Luminar catalog packages and History/edit stacks under Application Support/Skylum (user edits)",
    "ON1 catalog databases and user presets; only Photo SettingsCache / media caches for reclaim",
    "darktable library.db and ~/.config/darktable (sidecars/settings); only ~/.cache/darktable mipmaps",
    "RawTherapee config/presets; only cache/ subtrees",
    "Affinity .afphoto/.afdesign documents; Pixelmator documents",
    "Nikon NX Studio DB/, Canon/Sony/Fuji user settings and exported files",
    "Topaz AI model packs: medium or report-only (large re-downloads)",
    "AfterShot catalogs under Pictures (never-touch root; settings folder cache subdirs only when under Library)",
    "Adobe Camera Raw / Lightroom paths already in apps-creative (not duplicated here)"
  ],
  "risk_policy": {
    "app_caches_logs": "low, contents-only, min_age_days typically 7",
    "large_preview_thumbnail_trees": "report-only (can be tens of GB; regenerable but slow)",
    "ai_models_weights": "medium or report-only (Topaz models/coreMLCache)",
    "catalog_databases_presets_history": "never-touch or report-only; not default clean",
    "photoslibrary": "never-touch"
  },
  "sources": [
    "DxO forum: ~/Library/Caches/com.dxo.PhotoLabN previews; Application Support DxO PhotoLab Database vs cache",
    "DxO PureRAW installer paths (DxO Labs); bundle ids com.dxo / com.dxo-labs.PureRaw*",
    "Skylum support: Luminar Neo History/CacheDocuments; ~/Library/Caches/Skylum; Group Containers RTW788AXG3.com.skylum.luminarneo",
    "ON1 community: ~/Library/Application Support/ON1/**/Photo SettingsCache (often huge)",
    "darktable usermanual: --cachedir default $HOME/.cache/darktable; configdir $HOME/.config/darktable",
    "RawPedia File Paths: cache under Application Support/RawTherapee/cache and Containers",
    "Exposure Software support: ~/Library/Application Support/Exposure Software (and Alien Skin legacy)",
    "Nikon forum: ~/Library/Application Support/Nikon/NX Studio/{Cache,DB}",
    "Corel AfterShot Pro file-locations: ~/Library/Application Support/Corel AfterShot Pro 3",
    "Topaz Labs: coreMLCache under Application Support; models large re-download",
    "Existing 04-creative Affinity/Pixelmator/Capture One/Lightroom rules (residual only here)"
  ],
  "path_count": 233,
  "rules": [
