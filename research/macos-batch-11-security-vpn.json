{
  "batch": "11-security-vpn",
  "path_count": 141,
  "notes": "VPN and security apps: USER caches+logs under $HOME only. NEVER vaults, keychains, certs, .ovpn/.tblk configs, WireGuard private keys, password databases, or Authy token stores. No Documents/Desktop/Downloads/Keychains/Mail. Prefer delete_mode contents. Paths sourced from Homebrew cask zap lists, vendor docs, and common App Store container layouts.",
  "rules": [
    {
      "id": "app-wireguard-cache-logs",
      "name": "WireGuard App Store caches and logs",
      "description": "WireGuard macOS client regenerable caches and logs only. Never tunnel configs or private keys.",
      "category": "app-cache",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Caches/com.wireguard.macos",
        "$HOME/Library/Containers/com.wireguard.macos/Data/Library/Caches",
        "$HOME/Library/Containers/com.wireguard.macos/Data/Library/Logs",
        "$HOME/Library/Logs/WireGuard"
      ],
      "include_globs": [],
      "exclude_globs": [
        "**/*.conf",
        "**/*.key",
        "**/*private*"
      ],
      "delete_mode": "contents",
      "max_depth": 6,
      "report_only": false,
      "notes": "STRICT: never Group Containers tunnel store or Network Extension config with private keys."
    },
    {
      "id": "app-openvpn-connect-logs-cache",
      "name": "OpenVPN Connect logs and cache",
      "description": "OpenVPN Connect client diagnostic logs and cache. Not connection profiles or openvpn.keychain-db.",
      "category": "logs",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Logs/OpenVPN Connect",
        "$HOME/Library/Caches/org.openvpn.client.app",
        "$HOME/Library/Application Support/OpenVPN Connect/logs",
        "$HOME/Library/Application Support/OpenVPN Connect/log"
      ],
      "include_globs": [],
      "exclude_globs": [
        "**/*.ovpn",
        "**/*.conf",
        "**/*.p12",
        "**/*.pem",
        "**/*.crt",
        "**/*.key",
        "**/profiles/**",
        "**/Profiles/**"
      ],
      "delete_mode": "contents",
      "max_depth": 6,
      "report_only": false,
      "notes": "Never wipe whole Application Support/OpenVPN Connect (profiles). Never touch openvpn.keychain-db."
    },
    {
      "id": "app-tunnelblick-user-cache",
      "name": "Tunnelblick user cache only",
      "description": "Tunnelblick per-user cache under $HOME. Not Configurations, Shared configs, or system /Library logs that sit next to keys.",
      "category": "app-cache",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Caches/net.tunnelblick.tunnelblick",
        "$HOME/Library/Caches/com.apple.helpd/Generated/net.tunnelblick.tunnelblick.help*",
        "$HOME/Library/HTTPStorages/net.tunnelblick.tunnelblick"
      ],
      "include_globs": [],
      "exclude_globs": [
        "**/*.tblk/**",
        "**/*.ovpn",
        "**/*.conf",
        "**/*.crt",
        "**/*.key",
        "**/*.pem",
        "**/*.p12"
      ],
      "delete_mode": "contents",
      "max_depth": 6,
      "report_only": false,
      "notes": "NEVER $HOME/Library/Application Support/Tunnelblick/Configurations (keys/certs). System logs live under /Library/Application Support/Tunnelblick/Logs (out of $HOME scope)."
    },
    {
      "id": "app-nordvpn-cache-logs",
