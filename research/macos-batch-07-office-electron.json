{
  "batch": "07-office-electron",
  "title": "macOS Office/productivity, Electron app caches, installer leftovers",
  "path_count": 270,
  "notes": [
    "Caches and logs only; never Office/LibreOffice documents, vaults, or settings.",
    "Electron apps store Chromium subdirs (Cache, Code Cache, GPUCache, Dawn*, blob_storage, Crashpad, logs) under ~/Library/Application Support/<AppName>; do not wipe Local Storage, IndexedDB, Cookies, Preferences, User/.",
    "VS Code/Cursor: clean Cache/CachedData/Code Cache/GPUCache/CachedExtensionVSIXs/logs only; never User/ settings or extensions state.",
    "Docker Desktop: host Electron caches + log trees are low/medium; Docker.raw/qcow2 VM disks are report-only (not auto-delete).",
    "Transmission incomplete dirs are report-only (may hold wanted downloads). qBittorrent logs only.",
    "TextEdit autosave and Office WEF/add-in caches: close apps first; WEF wipe removes sideloaded add-ins.",
    "AirDrop/Continuity/Screenshot temps only under $TMPDIR (never whole /private/var/folders).",
    "User package receipts ~/Library/Receipts are rare; system /var/db/receipts is out of scope."
  ],
  "rules": [
    {
      "id": "macos-office-word-excel-ppt-caches",
      "name": "Microsoft Office app container caches",
      "description": "Word/Excel/PowerPoint/Outlook/OneNote sandbox Library/Caches (not documents).",
      "category": "app-cache",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Containers/com.microsoft.Word/Data/Library/Caches",
        "$HOME/Library/Containers/com.microsoft.Excel/Data/Library/Caches",
        "$HOME/Library/Containers/com.microsoft.Powerpoint/Data/Library/Caches",
        "$HOME/Library/Containers/com.microsoft.Outlook/Data/Library/Caches",
        "$HOME/Library/Containers/com.microsoft.onenote.mac/Data/Library/Caches"
      ],
      "delete_mode": "contents",
      "max_depth": 6,
      "report_only": false,
      "notes": "Microsoft-documented cache trees under Containers. Close Office apps first. Do not touch Data/Documents document trees."
    },
    {
      "id": "macos-office-addin-wef-cache",
      "name": "Microsoft Office add-in / OsfWebHost / WEF cache",
      "description": "Office JS add-in web host and WEF package caches (regenerable; clears sideloaded add-ins).",
      "category": "app-cache",
      "platform": "macos",
      "risk": "medium",
      "default_enabled": false,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Containers/com.Microsoft.OsfWebHost/Data",
        "$HOME/Library/Containers/com.microsoft.Word/Data/Documents/wef",
        "$HOME/Library/Containers/com.microsoft.Excel/Data/Documents/wef",
        "$HOME/Library/Containers/com.microsoft.Powerpoint/Data/Documents/wef",
        "$HOME/Library/Containers/com.microsoft.Word/Data/Library/Application Support/Microsoft/Office/16.0/Wef",
        "$HOME/Library/Containers/com.microsoft.Excel/Data/Library/Application Support/Microsoft/Office/16.0/Wef",
        "$HOME/Library/Containers/com.microsoft.Powerpoint/Data/Library/Application Support/Microsoft/Office/16.0/Wef",
        "$HOME/Library/Containers/com.microsoft.Office365ServiceV2/Data/Caches"
