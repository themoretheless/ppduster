{
  "batch": "12-design-ui",
  "platform": "macos",
  "description": "Regenerable cache/log/temp paths for design and UI tooling under $HOME beyond Figma Desktop/Sketch primary coverage (04-creative, 05-comms, 07-office-electron). Covers Canva, Framer, Penpot Desktop, Zeplin, Abstract, Marvel, InVision residual, Principle, ProtoPie, Axure RP, Balsamiq, Lunacy, Rotato, IconJar, Nucleo, SF Symbols app caches, RightFont, FontBase, Typeface, Figma Agent extras, Adobe XD residual, Whimsical, FigJam/Figma desktop extras, Photopea Electron wrappers, PixelSnap, xScope. path_count counts distinct path templates across rules. Caches and logs only; never user design files, icon/font libraries as sole copies, or cloud-synced project packages.",
  "never_touch_notes": [
    "User design documents: .sketch, local .fig exports, .rp/.rppr (Axure), .bmpr (Balsamiq), ProtoPie .pie, Principle documents, Lunacy documents, Framer project exports, Canva offline project roots under Documents",
    "IconJar set libraries under Application Support/IconJar and /Users/Shared/IconJar as delete-enabled (report-only inventory only)",
    "Nucleo icon collections under Application Support/Nucleo when they are the only copy (prefer Logs/Caches; full App Support is medium/report)",
    "Installed fonts under $HOME/Library/Fonts (batch 30 owns font files; this batch is manager app caches only)",
    "RightFont/FontBase/Typeface font activation libraries and vault DBs (caches/logs only by default)",
    "Adobe XD cloud documents and Creative Cloud Files (caches/logs residual only)",
    "Figma/FigJam cloud design files (never local wipe of Local Storage/IndexedDB session as sole auth wipe by default)",
    "Preferences plists, Keychains, Documents/Desktop/Downloads/Pictures roots, Mobile Documents, CloudStorage"
  ],
  "already_covered_primary": [
    "$HOME/Library/Application Support/Figma/Desktop/Cache (and DesktopProfile Electron caches in 04/07)",
    "$HOME/Library/Caches/com.figma.Desktop",
    "$HOME/Library/Caches/com.bohemiancoding.sketch3",
    "$HOME/Library/Caches/com.adobe.xd (base three paths in 04-creative)",
    "Font manager residual also appears in 30-fonts-icons (this batch keeps design-tooling focus + verified zap paths)"
  ],
  "risk_policy": {
    "electron_chromium_caches": "low, contents-only, min_age_days 5-7; close app first",
    "app_logs_crashpad": "low",
    "shipit_update_caches": "low",
    "httpstorages": "low",
    "icon_font_libraries_app_support_roots": "report-only or medium default_enabled false",
    "invision_marvel_discontinued_residual": "low if present; leftover after product sunset",
    "adobe_xd_residual": "low caches/logs; not Creative Cloud Files"
  },
  "sources": [
    "Homebrew cask zap: canva, framer, zeplin, abstract, marvel, principle, protopie, axure-rp, balsamiq-wireframes, lunacy, rotato, iconjar, nucleo, whimsical, rightfont, fontbase, typeface, pixelsnap, xscope, figma, figma-agent, sf-symbols",
    "Zeplin Help: clear ~/Library/Caches/io.zeplin.osx",
    "Canva Help: remove Canva-related folders under ~/Library (desktop Electron)",
    "Penpot Desktop (author-more): appId com.authormore.penpotdesktop; Electron userData under Application Support/Penpot Desktop",
    "Figma agent cask zap: Caches/com.figma.agent, HTTPStorages/com.figma.agent",
    "PixelSnap Sparkle issue paths: com.getpixelsnap.app; v2 pl.maketheweb.pixelsnap2",
    "Lunacy cask: ~/.local/share/Icons8/Lunacy",
    "Existing 04-creative Adobe XD / Figma / Sketch; 07 Figma electron; 30-fonts-icons RightFont/FontBase/Typeface/SF Symbols residual"
  ],
  "path_count": 266,
  "rules": [
