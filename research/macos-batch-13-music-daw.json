{
  "batch": "13-music-daw",
  "platform": "macos",
  "description": "Regenerable DAW and audio-plugin caches, logs, indexes, and download staging under $HOME on macOS. Project files, song/session documents, and large sample/content libraries are never delete-enabled (report-only only where listed). path_count counts distinct path templates across rules.",
  "never_touch_notes": [
    "User project/session files (.als, .flp, .rpp, .logicx, .bwproject, .song, .cpr, .npr, Audacity projects)",
    "Sample/content libraries as delete-enabled: Ableton Packs/User Library, Komplete/Kontakt libraries, Spitfire/Output Arcade content, Steinberg VST Sound content, Waves Instrument Data, Arturia factory content",
    "$HOME/Music and $HOME/Documents roots (never-touch); no bulk wipe of Music/Ableton, Documents/Image-Line, Documents/Studio One",
    "Plugin binaries under /Library/Audio/Plug-Ins (system, not $HOME) and licenses (iLok, Waves licenses, Plugin Alliance license files, Native Service Center entitlements)",
    "Preferences roots that hold authorizations (prefer cache/log leaves only)"
  ],
  "path_count": 252,
  "risk_policy": {
    "daw_app_caches_logs": "low (regenerable indexes, waveform/peak caches, crash logs)",
    "plugin_scan_indexes": "low or medium (rescans on next launch; brief startup cost)",
    "download_staging_pack_downloads": "low (re-download)",
    "sample_content_libraries": "report-only (large; intentional offline content)",
    "session_temp_analysis_caches": "medium (Melodyne separations, RX session data, Audacity Session Data; regenerable but may force re-analysis)"
  },
  "rules": [
    {
      "id": "daw-ableton-live-caches",
      "name": "Ableton Live cache tree",
      "description": "Default Live Cache and related Ableton cache tree under ~/Library/Caches. Regenerable; close Live first. Not User Library or installed Packs.",
      "category": "app-cache",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "report_only": false,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Caches/Ableton",
        "$HOME/Library/Caches/Ableton/Cache",
        "$HOME/Library/Caches/Ableton/PackDownloads"
      ],
      "delete_mode": "contents",
      "max_depth": 8,
      "notes": "Official uninstall lists ~/Library/Caches/Ableton. PackDownloads is download staging; Packs install location is separate (often Music/Ableton, never-touch)."
    },
    {
      "id": "daw-ableton-live-logs-support-temps",
      "name": "Ableton Live logs and support temps",
      "description": "Ableton logs and regenerable temp/index leaves under Application Support. Does not delete whole Application Support/Ableton (prefs/databases).",
      "category": "app-cache",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "report_only": false,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Logs/Ableton",
        "$HOME/Library/Logs/Ableton Live",
        "$HOME/Library/Application Support/Ableton/Live Reports",
        "$HOME/Library/Application Support/Ableton/Crash"
      ],
      "include_globs": [
        "**/Tmp/**",
        "**/Temp/**",
        "**/Cache/**",
        "**/Logs/**"
      ],
      "delete_mode": "contents",
      "max_depth": 8,
      "notes": "Keep Live Database and Preferences elsewhere. Bundle id caches com.ableton.* covered in residual rule."
    },
    {
      "id": "daw-ableton-bundle-caches",
      "name": "Ableton bundle-id caches",
      "description": "com.ableton.* entries under Library/Caches.",
      "category": "app-cache",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "report_only": false,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Caches/com.ableton.live",
        "$HOME/Library/Caches/com.ableton.live.Lockfile",
        "$HOME/Library/WebKit/com.ableton.live",
        "$HOME/Library/HTTPStorages/com.ableton.live"
      ],
      "delete_mode": "contents",
      "max_depth": 6
    },
    {
      "id": "daw-ableton-packs-library-report",
      "name": "Ableton Packs and User Library (report-only)",
      "description": "Installed Packs and User Library content. Large re-downloads; user presets live here. Report size only.",
      "category": "sample-library",
      "platform": "macos",
      "risk": "report-only",
      "default_enabled": false,
      "report_only": true,
      "min_age_days": 0,
      "paths": [
        "$HOME/Library/Application Support/Ableton/Factory Packs",
        "$HOME/Music/Ableton",
        "$HOME/Music/Ableton/Factory Packs",
        "$HOME/Music/Ableton/User Library"
      ],
      "delete_mode": "contents",
      "max_depth": 4,
      "notes": "Never auto-delete. Music/* may be never-touch in engine; still listed for inventory. Prefer Ableton Library preferences paths."
    },
    {
      "id": "daw-fl-studio-caches",
      "name": "FL Studio / Image-Line caches",
      "description": "Image-Line and FL Studio regenerable caches under user Library. Not Documents/Image-Line user data or projects.",
      "category": "app-cache",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "report_only": false,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Caches/Image-Line",
        "$HOME/Library/Caches/FL Studio",
        "$HOME/Library/Caches/com.image-line.flstudio",
        "$HOME/Library/Caches/com.image-line.shared"
      ],
      "delete_mode": "contents",
      "max_depth": 8
    },
    {
      "id": "daw-fl-studio-logs-support",
      "name": "FL Studio logs and shared support temps",
      "description": "Logs and Application Support leaves that are cache-like. Avoid wiping license/settings plists wholesale.",
      "category": "app-cache",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "report_only": false,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Logs/Image-Line",
        "$HOME/Library/Logs/FL Studio",
        "$HOME/Library/Application Support/Image-Line/Shared/Cache",
        "$HOME/Library/Application Support/Image-Line/FL Studio/Cache",
        "$HOME/Library/Application Support/Image-Line/FL Studio/Logs"
