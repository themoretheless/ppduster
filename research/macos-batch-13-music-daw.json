        "$HOME/Library/Caches/com.cockos.reaper",
        "$HOME/Library/Caches/com.cockos.REAPER",
        "$HOME/Library/Application Support/REAPER/MediaDB",
        "$HOME/Library/Application Support/REAPER/Cache",
        "$HOME/Library/Application Support/REAPER/Caches"
      ],
      "delete_mode": "contents",
      "max_depth": 6,
      "notes": "Resource path default ~/Library/Application Support/REAPER. Plugin cache files (reaper-vstplugins*.ini, reaper-fxcache) regenerate on rescan; optional include via support rule."
    },
    {
      "id": "daw-reaper-plugin-cache-files",
      "name": "REAPER plugin scan cache files",
      "description": "Known regenerable VST/FX cache files in REAPER resource path. Close REAPER first; next launch rescans plugins.",
      "category": "app-cache",
      "platform": "macos",
      "risk": "medium",
      "default_enabled": false,
      "report_only": false,
      "min_age_days": 0,
      "paths": [
        "$HOME/Library/Application Support/REAPER"
      ],
      "include_globs": [
        "**/reaper-vstplugins*.ini",
        "**/reaper-fxcache*",
        "**/reaper-jsfxcache*",
        "**/mediadb*"
      ],
      "exclude_globs": [
        "**/reaper.ini",
        "**/reaper-license*",
        "**/Scripts/**",
        "**/ColorThemes/**",
        "**/KeyMaps/**"
      ],
      "delete_mode": "contents",
      "max_depth": 4,
      "notes": "Medium: rescans can be slow with large plugin counts. Peak .reapeaks often live beside media or user alternate path (not fixed)."
    },
    {
      "id": "daw-reaper-logs",
      "name": "REAPER logs",
      "description": "REAPER and Cockos log folders under user Library.",
      "category": "logs",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "report_only": false,
      "min_age_days": 14,
