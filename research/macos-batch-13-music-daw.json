      "delete_mode": "contents",
      "max_depth": 8,
      "notes": "User projects default under Documents/Image-Line (never-touch root). Prefs folder Image-Line under Preferences is settings, not targeted here."
    },
    {
      "id": "daw-reaper-caches",
      "name": "REAPER caches and media database",
      "description": "REAPER bundle caches and regenerable MediaDB / FX cache leaves under resource path. Not scripts, reaper.ini, or project .rpp files.",
      "category": "app-cache",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "report_only": false,
      "min_age_days": 7,
      "paths": [
