{
  "batch": "40-containers-orphans",
  "platform": "macos",
  "title": "Sandboxed Containers and Group Containers residual caches (not full wipe)",
  "description": "Low-risk regenerable CACHE/LOG/tmp/WebKit/HTTPStorages leaves under $HOME/Library/Containers and Group Containers for common Apple utilities and terminal residuals. Explicit per-app rules for Calculator, Weather, Stocks, News, Freeform, Journal, Passwords residual, Shortcuts, Automator, Script Editor, Terminal residual, iTerm2/Warp/Alacritty/Kitty/Hyper/Fig, Console, Activity Monitor, Disk Utility, System Information, Font Book, Archive Utility, Screenshot, Preview deeper, QuickTime residual, TextEdit residual, Chess, Stickies, Grapher, Voice Memos cache, Clock/World Clock, Home residual caches. Full Containers inventory is report-only. Never wipe whole Containers/* trees or container Documents/Application Support user content.",
  "safety_notes": [
    "NEVER delete $HOME/Library/Containers/<bundle> or Group Containers roots wholesale. Only Caches, Logs, tmp, WebKit, HTTPStorages (and named residual cache leaves).",
    "NEVER touch container Data/Documents, Data/Desktop, Data/Downloads, Data/Movies, Data/Music, Data/Pictures, or Keychains.",
    "Passwords.app: residual Caches/HTTPStorages/tmp only. Never password DBs, Keychain, or Passwords Application Support content.",
    "Freeform/Journal: board and journal content live outside pure Caches; never group document stores as delete-enabled.",
    "Voice Memos: never group.com.apple.VoiceMemos.shared/Recordings or container Documents recordings.",
    "Stickies: sticky note bodies are app data; only Caches/Logs/tmp residual.",
    "Home/HomeKit: residual Caches/HTTPStorages only; never HomeKit configuration databases.",
    "Shortcuts: never workflow packages under Application Support/group shortcuts; Caches/Logs/tmp only.",
    "Terminals: clean caches/logs only; never shell history, DynamicProfiles, Warp themes/config, kitty.conf, alacritty.yml.",
    "Preview/TextEdit/QuickTime: deeper residual caches and tmp only; autosave may be medium (close app first) and is opt-in.",
    "Mail/Messages/Notes/Safari full containers excluded from pattern rules (covered elsewhere or never-touch).",
    "path_count counts distinct path templates across rules (including report-only inventory paths)."
  ],
  "risk_policy": {
    "container_library_caches_logs_tmp_httpstorages": "low",
    "container_webkit_leaves": "low to medium",
    "terminal_app_caches_logs": "low",
    "textedit_preview_autosave": "medium (close app; default_enabled false)",
    "full_containers_inventory": "report-only",
    "group_container_document_stores": "never-touch or report-only",
    "passwords_credentials_keychain": "never-touch (excluded)"
  },
  "sources": [
    "Live host Containers listing (com.apple.calculator, weather, stocks, news, freeform, journal, Passwords, shortcuts, Preview, QuickTimePlayerX, TextEdit, Chess, Stickies, clock, Home, VoiceMemos, FontBook, archiveutility, controls.screenshot, SystemProfiler.AboutExtension)",
    "Live Group Containers: group.com.apple.weather, stocks, news, freeform, Journal, shortcuts, VoiceMemos.shared, screencapture, Home.group, mobiletimerd, ArchiveUtility.PKSignedContainer",
    "mdls kMDItemCFBundleIdentifier for Terminal, Console, Activity Monitor, Disk Utility, SystemProfiler, Grapher, ScriptEditor2, Automator, screenshot.launcher, Calculator, Chess, Stickies, FontBook",
    "iTerm2 residual: ~/Library/Caches/com.googlecode.iterm2, ~/Library/Logs/iTerm2 (configs under Application Support/iTerm2 excluded)",
    "Warp: dev.warp.Warp-Stable; Alacritty org.alacritty; kitty net.kovidgoyal.kitty; Hyper co.zeit.hyper; Fig com.fig.desktop / com.withfig.fig",
    "macos-batch-01 weather/news/stocks partial; batch-10 Containers pattern; apps-office-electron Preview/QuickTime/TextEdit/Archive Utility baseline (this batch goes deeper and adds orphan utilities)"
  ],
  "path_count": 297,
  "rules": [
