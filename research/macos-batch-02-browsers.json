{
  "batch": "02-browsers",
  "path_count": 154,
  "notes": "Regenerable browser caches only on macOS under $HOME. Excludes cookies, Login Data, History, Bookmarks, password-bearing Web Data, Session Storage, and whole-profile wipes. Prefer quit-browser-first. Service Worker CacheStorage is medium risk (PWAs re-cache). Already-shipped Safari favicon/preview, Firefox cache2/startupCache, and Chromium Code/GPU/Dawn/Shader for Chrome/Chromium/Brave/Edge/Vivaldi/Arc are extended here with more channels, HTTP/media/Crashpad/CRX/OptimizationGuide leaves, and niche browsers.",
  "sources": [
    "Live inspection of Library/Caches and Application Support on research host (Edge full tree, Chrome Dev Cache/Code Cache, Safari WebKitCache/container)",
    "Chromium user-data dir layout (Application Support channel folders)",
    "Homebrew cask zap paths (Chrome, DuckDuckGo, Orion, Sidekick)",
    "Orion FAQ WebKit/cache paths",
    "Mole Dia browser path correction (Caches/Dia/User Data, AS/Dia/User Data)",
    "Tor Browser TorBrowser-Data layout",
    "Common cleaner tools (DevCacheCleaner, mTTCleaner) browser path lists"
  ],
  "rules": [
    {
      "id": "macos-safari-webkit-disk-cache",
      "name": "Safari WebKit HTTP disk cache",
      "description": "Safari/WebKit HTTP and resource disk caches in legacy Caches and sandboxed container. Rebuilds on browse.",
      "category": "browser-cache",
      "platform": "macos",
      "risk": "medium",
      "default_enabled": false,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Caches/com.apple.Safari/WebKitCache",
        "$HOME/Library/Caches/com.apple.Safari/fsCachedData",
        "$HOME/Library/Containers/com.apple.Safari/Data/Library/Caches/com.apple.Safari/WebKitCache",
        "$HOME/Library/Containers/com.apple.Safari/Data/Library/Caches/com.apple.Safari/fsCachedData",
        "$HOME/Library/Containers/com.apple.Safari/Data/Library/Caches/com.apple.Safari/TabSnapshots",
        "$HOME/Library/Containers/com.apple.Safari/Data/Library/Caches/WebKit"
      ],
      "include_globs": [],
      "exclude_globs": [],
      "delete_mode": "contents",
      "max_depth": 6,
      "report_only": false,
      "notes": "On Safari 17+/Sonoma the container path often holds the bulk. Close Safari first. Does not touch Bookmarks, History, or WebsiteData cookies."
    },
    {
      "id": "macos-safari-safebrowsing-cache",
      "name": "Safari Safe Browsing cache",
      "description": "Google/Apple Safe Browsing threat list cache used by Safari.",
      "category": "browser-cache",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Caches/com.apple.Safari.SafeBrowsing"
      ],
      "include_globs": [],
      "exclude_globs": [],
      "delete_mode": "contents",
      "max_depth": 4,
      "report_only": false,
      "notes": "Regenerated from network; temporary reduction in Safe Browsing coverage until re-fetched."
    },
    {
