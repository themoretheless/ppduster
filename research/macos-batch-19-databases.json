{
  "batch": "19-databases",
  "platform": "macos",
  "platform_focus": "macos",
  "title": "Local database tools: caches, logs, and data-dir inventory",
  "notes": "Desktop DB clients and local server packages under $HOME and user-writable Homebrew prefixes. Regenerable UI/Electron caches and app logs may be low with age gates. Data directories (Postgres.app clusters, brew PostgreSQL/MySQL/Mongo/Redis data, Neo4j Desktop graphs, Redis dump.rdb, Docker named volumes / Docker.raw-backed volume store) are REPORT-ONLY. Residual Application Support trees after uninstall (TablePlus, Sequel Ace, Compass, RedisInsight, Beekeeper, DataGrip config) are report-only; they often hold connection profiles. CLI history (.mysql_history, litecli, redis-cli) is report-only (may contain secrets). Prefer native prune for Docker volumes. Does not auto-delete live database files or credentials stores. Overlaps intentionally catalogued with batch-07 cache-only rules; this batch owns residual roots and server data inventory.",
  "path_count": 247,
  "risk_policy": {
    "ui_electron_caches_logs": "low with min_age_days",
    "driver_download_caches": "low or medium",
    "connection_config_residuals": "report-only",
    "server_data_directories": "report-only (never default delete)",
    "redis_rdb_dumps": "report-only",
    "docker_volumes_raw": "report-only (native docker volume prune only)",
    "cli_sql_history": "report-only (privacy: may hold secrets)"
  },
  "never_delete_examples": [
    "$HOME/Library/Application Support/Postgres/var-*",
    "/opt/homebrew/var/postgresql@*",
    "/opt/homebrew/var/mysql",
    "$HOME/dump.rdb",
    "Docker named volumes and Docker.raw"
  ],
  "rules": [
    {
      "id": "db-postgresapp-logs",
      "name": "Postgres.app server logs",
      "description": "PostgreSQL log files under Postgres.app cluster var directories (not the data files themselves).",
      "category": "logs",
      "platform": "macos",
      "risk": "medium",
      "default_enabled": false,
      "report_only": false,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Application Support/Postgres"
      ],
      "include_globs": [
        "**/log/**",
        "**/pg_log/**",
        "**/*.log",
        "**/postgresql-*.log",
        "**/postgresql-*.csv"
      ],
      "delete_mode": "contents",
      "max_depth": 6,
      "notes": "Only log/pg_log trees inside Application Support/Postgres. Never wipe var-XX base, base/, global/, pg_wal, or entire cluster."
    },
    {
      "id": "db-postgresapp-data-report",
      "name": "Postgres.app data directories (report-only)",
      "description": "Default Postgres.app cluster data dirs (var-XX). Live databases; inventory only.",
      "category": "db-data",
      "platform": "macos",
      "risk": "report-only",
      "default_enabled": false,
      "report_only": true,
      "min_age_days": 0,
      "paths": [
        "$HOME/Library/Application Support/Postgres"
      ],
      "delete_mode": "path",
      "max_depth": 3,
      "notes": "Official default: ~/Library/Application Support/Postgres/var-XX. Deleting destroys all local DBs. Uninstall via Postgres.app docs only."
    },
    {
      "id": "db-postgresapp-prefs-residual-report",
      "name": "Postgres.app preferences residual (report-only)",
      "description": "User defaults and leftover support after uninstall.",
      "category": "leftovers",
      "platform": "macos",
      "risk": "report-only",
      "default_enabled": false,
      "report_only": true,
      "min_age_days": 0,
      "paths": [
        "$HOME/Library/Preferences/com.postgresapp.Postgres2.plist",
        "$HOME/Library/Preferences/com.postgresapp.Postgres.plist",
        "$HOME/Library/Saved Application State/com.postgresapp.Postgres2.savedState",
        "$HOME/Library/Caches/com.postgresapp.Postgres2"
      ],
      "delete_mode": "path",
      "max_depth": 2,
      "notes": "Prefs/saved state only; not var data. defaults delete com.postgresapp.Postgres2 is the documented uninstall step."
