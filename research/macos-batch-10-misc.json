        "$HOME/Library/Caches/CloudKit",
        "$HOME/Library/Caches/com.apple.bird",
        "$HOME/Library/Group Containers/com.apple.bird",
        "$HOME/Library/Group Containers/group.com.apple.CloudDocs"
