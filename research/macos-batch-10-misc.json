      "delete_mode": "contents",
      "max_depth": 8,
      "notes": "Removes downloaded episode media/cache; user must re-download. Not Music library."
    },
    {
      "id": "macos-books-caches",
      "name": "Apple Books caches (not purchased books library)",
      "category": "media-cache",
      "risk": "medium",
      "report_only": false,
      "default_enabled": false,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Containers/com.apple.iBooksX/Data/Library/Caches",
        "$HOME/Library/Containers/com.apple.iBooksX.BooksThumbnail/Data/Library/Caches",
