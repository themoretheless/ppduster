      "notes": "Do not delete iCloud Drive content or Mobile Documents. CloudKit/bird caches are sensitive; report sizes and point to Optimize Storage."
    },
    {
      "id": "macos-optimized-storage-hints",
      "name": "Optimized Storage related caches (careful)",
      "category": "icloud",
      "risk": "medium",
      "report_only": false,
      "default_enabled": false,
