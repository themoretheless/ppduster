{
  "batch": "10-misc",
  "path_count": 221,
  "notes": "Miscellaneous macOS reclaim paths under $HOME (user Library preferred) plus a few user-writable shared temps. Never-touch excluded: Documents/Desktop/Downloads/Pictures/Movies/Music/Photos, Keychains, Mail/Messages/Calendars, Mobile Documents, CloudStorage, .ssh/.gnupg, /System, /Applications, system /Library. Mail containers deliberately omitted. Full VMs/bottles/prefixes are report-only or out of scope; only caches/logs called out.",
  "rules": [
    {
      "id": "macos-tm-local-snapshots-report",
      "name": "Time Machine local APFS snapshots (report-only)",
      "category": "system-data",
      "risk": "report-only",
      "report_only": true,
      "default_enabled": false,
      "min_age_days": 0,
      "paths": [],
      "native_hints": [
        "tmutil listlocalsnapshots /",
        "tmutil listlocalsnapshotdates",
        "sudo tmutil thinlocalsnapshots / 10000000000 1"
      ],
      "notes": "Not a filesystem path under $HOME; reclaim via tmutil only. Never rm .localsnapshots. Report size via diskutil apfs listSnapshots / if needed."
    },
    {
      "id": "macos-system-data-tips-report",
      "name": "System Data storage tips (report-only native)",
      "category": "system-data",
      "risk": "report-only",
      "report_only": true,
      "default_enabled": false,
      "min_age_days": 0,
      "paths": [],
      "native_hints": [
        "du -sh \"$HOME/Library/Caches\" \"$HOME/Library/Logs\" \"$HOME/Library/Developer\"",
        "tmutil listlocalsnapshots /",
        "diskutil apfs list",
        "storage"
      ],
      "notes": "System Data is an aggregate category in Storage settings, not one folder. Point users at native Storage UI and known regenerable roots; no bulk wipe."
    },
    {
      "id": "macos-empty-trash-os-hint",
      "name": "Empty Trash is OS responsibility",
      "category": "leftovers",
      "risk": "report-only",
      "report_only": true,
      "default_enabled": false,
      "min_age_days": 0,
      "paths": [
        "$HOME/.Trash"
      ],
      "native_hints": [
        "osascript -e 'tell application \"Finder\" to empty trash'"
      ],
      "notes": "Report aged items only. Do not implement Empty Trash as default clean; Finder/OS owns trash semantics and put-back."
    },
    {
      "id": "macos-trash-old-items-report",
      "name": "Old items in user Trash (report-only)",
      "category": "leftovers",
      "risk": "report-only",
      "report_only": true,
      "default_enabled": false,
      "min_age_days": 30,
      "paths": [
        "$HOME/.Trash"
      ],
      "delete_mode": "contents",
      "max_depth": 4,
      "notes": "Inventory only: large/old Trash contents. Never auto-empty."
    },
    {
      "id": "macos-private-tmp-aged",
      "name": "Shared /private/tmp aged files",
      "category": "temp",
      "risk": "medium",
      "report_only": false,
      "default_enabled": false,
      "min_age_days": 3,
      "paths": [
        "/private/tmp",
        "/tmp"
      ],
      "delete_mode": "contents",
      "max_depth": 3,
      "notes": "World-writable shared temp. Age-filter + skip open files. Never delete directory nodes. Prefer $TMPDIR for user-owned temps."
    },
    {
      "id": "macos-var-tmp-user-accessible",
      "name": "User-accessible /var/tmp leftovers",
      "category": "temp",
      "risk": "medium",
      "report_only": false,
      "default_enabled": false,
      "min_age_days": 7,
      "paths": [
        "/var/tmp",
        "/private/var/tmp"
      ],
      "include_globs": [
        "**/sysdiagnose*",
        "**/*sysdiagnose*",
        "**/TemporaryItems/**"
      ],
      "delete_mode": "contents",
      "max_depth": 4,
      "notes": "sysdiagnose and other aged dumps sometimes land here. Only user-owned files; skip root-owned."
    },
    {
      "id": "macos-sysdiagnose-user-library",
      "name": "sysdiagnose leftovers under user Library",
      "category": "logs",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Logs/DiagnosticReports",
        "$HOME/Library/Logs/DiagnosticReports/Retired"
      ],
      "include_globs": [
        "**/sysdiagnose*",
        "**/*sysdiagnose*"
      ],
      "delete_mode": "contents",
      "max_depth": 4,
      "notes": "Aged diagnostic dumps only; leave recent .ips crash reports structure."
    },
    {
      "id": "macos-diagnostic-reports-retired",
      "name": "Retired diagnostic reports",
      "category": "logs",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Logs/DiagnosticReports/Retired"
      ],
      "delete_mode": "contents",
      "max_depth": 3,
      "notes": "Retired .ips/.crash files; safe regenerable diagnostics."
    },
    {
      "id": "macos-diagnostic-reports-ips",
      "name": "User DiagnosticReports .ips",
      "category": "logs",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 21,
      "paths": [
        "$HOME/Library/Logs/DiagnosticReports"
      ],
      "include_globs": [
        "**/*.ips",
        "**/*.crash",
        "**/*.spin",
        "**/*.diag"
      ],
      "exclude_globs": [
        "Retired",
        "Retired/**"
      ],
      "delete_mode": "contents",
      "max_depth": 3,
      "notes": "Aged crash/diag reports. Exclude Mail-related never-touch trees elsewhere."
    },
    {
      "id": "macos-crash-reporter-user",
      "name": "User CrashReporter logs",
      "category": "logs",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Logs/CrashReporter",
        "$HOME/Library/Application Support/CrashReporter"
      ],
      "delete_mode": "contents",
      "max_depth": 4,
      "notes": "Legacy and current crash reporter trees under user Library."
    },
    {
      "id": "macos-logarchive-user",
      "name": "User .logarchive bundles",
      "category": "logs",
      "risk": "low",
      "report_only": false,
      "default_enabled": false,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Logs"
      ],
      "include_globs": [
        "**/*.logarchive",
        "**/*.logarchive/**"
      ],
      "delete_mode": "contents",
      "max_depth": 6,
      "notes": "Unified logging archives dropped by Console/sysdiagnose into user Logs."
    },
    {
      "id": "macos-launchagents-logs",
      "name": "LaunchAgent-adjacent user logs",
      "category": "logs",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Logs"
      ],
      "include_globs": [
        "**/*agent*.log",
        "**/*Agent*.log",
        "**/*updater*.log",
        "**/*Updater*.log"
      ],
      "delete_mode": "contents",
      "max_depth": 5,
      "notes": "Do not delete LaunchAgents plists ($HOME/Library/LaunchAgents). Logs only."
    },
    {
      "id": "macos-agent-crash-logs",
      "name": "Background agent crash logs",
      "category": "logs",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Logs/DiagnosticReports",
        "$HOME/Library/Logs/CrashReporter",
        "$HOME/Library/Logs/Baseband",
        "$HOME/Library/Logs/CoreSimulator"
      ],
      "delete_mode": "contents",
      "max_depth": 4,
      "notes": "Agent/daemon crash dumps and simulator logs in user space."
    },
    {
      "id": "macos-preferences-backups",
      "name": "Preferences backup-like leftovers",
      "category": "leftovers",
      "risk": "medium",
      "report_only": false,
      "default_enabled": false,
      "min_age_days": 30,
      "paths": [
        "$HOME/Library/Preferences"
      ],
      "include_globs": [
        "**/*.bak",
        "**/*.old",
        "**/*.backup",
        "**/*~.plist",
        "**/*.plist.bak",
        "**/*.plist.old"
      ],
      "exclude_globs": [
        "ByHost",
        "ByHost/**",
        "com.apple.security*",
        "com.apple.security*/**"
      ],
      "delete_mode": "contents",
      "max_depth": 3,
      "notes": "Explicit backup extensions only. Never wipe live plists or Keychain-related prefs."
    },
    {
      "id": "macos-preferences-byhost-orphans-report",
      "name": "ByHost preferences inventory (report-only)",
      "category": "leftovers",
      "risk": "report-only",
      "report_only": true,
      "default_enabled": false,
      "min_age_days": 0,
      "paths": [
        "$HOME/Library/Preferences/ByHost"
      ],
      "delete_mode": "contents",
      "max_depth": 2,
      "notes": "Machine-UUID-scoped prefs. Orphans after hardware change exist but auto-delete is risky."
    },
    {
      "id": "macos-containers-caches-pattern",
      "name": "Sandboxed app container caches",
      "category": "caches",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Containers"
      ],
      "include_globs": [
        "*/Data/Library/Caches/**",
        "*/Data/tmp/**",
        "*/Data/Library/Logs/**"
      ],
      "exclude_globs": [
        "com.apple.mail",
        "com.apple.mail/**",
        "com.apple.MobileSMS",
        "com.apple.MobileSMS/**",
        "com.apple.Notes",
        "com.apple.Notes/**",
        "com.apple.Safari",
        "com.apple.Safari/**",
        "com.apple.stocks",
        "com.apple.stocks/**",
        "com.apple.Keynote",
        "com.apple.Keynote/**",
        "com.apple.iWork.*",
        "com.apple.iWork.*/**"
      ],
      "delete_mode": "contents",
      "max_depth": 8,
      "notes": "Pattern: Containers/<bundle>/Data/Library/Caches. Skip Mail and other never-touch app data roots. Contents of Caches/Logs/tmp only."
    },
    {
      "id": "macos-group-containers-caches",
      "name": "Group Containers caches",
      "category": "caches",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Group Containers"
      ],
      "include_globs": [
        "*/Library/Caches/**",
        "*/Library/Logs/**"
      ],
      "exclude_globs": [
        "com.apple.messages",
        "com.apple.messages/**",
        "group.com.apple.calendar",
        "group.com.apple.calendar/**",
        "group.com.apple.notes",
        "group.com.apple.notes/**",
        "com.apple.MailPersonaStorage",
        "com.apple.MailPersonaStorage/**",
        "group.com.apple.Photos*",
        "group.com.apple.Photos*/**",
        "com.apple.bird",
        "com.apple.bird/**",
        "group.com.apple.CloudDocs",
        "group.com.apple.CloudDocs/**"
      ],
      "delete_mode": "contents",
      "max_depth": 8,
      "notes": "App group caches only. Exclude Messages/Mail/Notes/Photos/iCloud bird/CloudDocs group data."
    },
    {
      "id": "macos-httpstorages-cache",
      "name": "HTTPStorages URL cache",
      "category": "caches",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/HTTPStorages"
      ],
      "delete_mode": "contents",
      "max_depth": 5,
      "notes": "NSURLSession disk caches per process. Regenerable."
    },
    {
      "id": "macos-webkit-website-data-cache",
      "name": "WebKit process caches (user)",
      "category": "caches",
      "risk": "medium",
      "report_only": false,
      "default_enabled": false,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/WebKit",
        "$HOME/Library/Caches/com.apple.WebKit.Networking",
        "$HOME/Library/Caches/com.apple.WebKit.WebContent",
        "$HOME/Library/Caches/WebKit"
      ],
      "include_globs": [
        "**/WebsiteData/Cached*/**",
        "**/CacheStorage/**",
        "**/WebKitCache/**"
      ],
      "delete_mode": "contents",
      "max_depth": 8,
      "notes": "Caches only; do not wipe WebsiteData credentials or IndexedDB wholesale in default mode."
    },
    {
      "id": "macos-geoservices-cache",
      "name": "GeoServices / Maps tile cache",
      "category": "caches",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Caches/GeoServices",
        "$HOME/Library/Caches/com.apple.geod",
        "$HOME/Library/Caches/com.apple.geoanalyticsd"
      ],
      "delete_mode": "contents",
      "max_depth": 5,
      "notes": "Offline map tiles and geo analytics caches rebuild on use."
    },
    {
      "id": "macos-ams-media-caches",
      "name": "Apple Media Services caches",
      "category": "caches",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Caches/com.apple.AppleMediaServices",
        "$HOME/Library/Caches/com.apple.AMPLibraryAgent",
        "$HOME/Library/Caches/com.apple.AMPDevicesAgent",
        "$HOME/Library/Caches/com.apple.itunescloudd",
        "$HOME/Library/Caches/com.apple.nbagent",
        "$HOME/Library/Caches/PassKit"
      ],
      "delete_mode": "contents",
      "max_depth": 5,
      "notes": "Music/TV/App Store related media metadata caches. Not user media libraries."
    },
    {
      "id": "macos-appstore-caches",
      "name": "Mac App Store agent caches",
      "category": "package-cache",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Caches/com.apple.appstoreagent",
        "$HOME/Library/Caches/com.apple.appstorecomponentsd",
        "$HOME/Library/Caches/com.apple.storekitagent",
        "$HOME/Library/Caches/com.apple.commerce",
        "$HOME/Library/Containers/com.apple.AppStore/Data/Library/Caches"
      ],
      "delete_mode": "contents",
      "max_depth": 6,
      "notes": "App Store UI/download agent caches under user Library. Not /Library/Updates (system)."
    },
    {
      "id": "macos-software-update-user-cache",
      "name": "Software Update user-side catalog cache",
      "category": "package-cache",
      "risk": "medium",
      "report_only": false,
      "default_enabled": false,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Caches/com.apple.SoftwareUpdate",
        "$HOME/Library/Caches/com.apple.nsurlsessiond",
        "$HOME/Library/HTTPStorages/com.apple.SoftwareUpdateNotificationManager",
        "$HOME/Library/HTTPStorages/softwareupdate",
        "$HOME/Library/Logs/SoftwareUpdateCore"
      ],
      "delete_mode": "contents",
      "max_depth": 5,
      "notes": "User-accessible SU caches/logs only. Never touch /Library/Updates or /System/Library/AssetsV2."
    },
    {
      "id": "macos-ios-ipsw-mobile-software-update",
      "name": "iOS software update / IPSW leftovers",
      "category": "leftovers",
      "risk": "medium",
      "report_only": false,
      "default_enabled": false,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/iTunes/iPhone Software Updates",
        "$HOME/Library/iTunes/iPad Software Updates",
        "$HOME/Library/iTunes/iPod Software Updates",
        "$HOME/Library/iTunes/iPhone Carrier Support",
        "$HOME/Library/Application Support/MobileSoftwareUpdate",
        "$HOME/Library/Caches/com.apple.MobileSoftwareUpdate"
      ],
      "delete_mode": "contents",
      "max_depth": 5,
      "notes": "Old IPSW/carrier support packages from Finder/iTunes device updates. Large and re-downloadable. Distinct from MobileSync backups (report-only elsewhere)."
    },
    {
      "id": "macos-installer-leftovers-user",
      "name": "macOS installer leftovers (user-accessible)",
      "category": "leftovers",
      "risk": "medium",
      "report_only": false,
      "default_enabled": false,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Caches/com.apple.installer",
        "$HOME/Library/Caches/com.apple.PackageKit",
        "$HOME/Library/Caches/com.apple.installd",
        "$HOME/Applications"
      ],
      "include_globs": [
        "**/Install macOS*",
        "**/Install macOS*/**",
        "**/Install OS X*",
        "**/Install OS X*/**"
      ],
      "delete_mode": "contents",
      "max_depth": 4,
      "notes": "User ~/Applications installer apps and user PackageKit caches. Never scan /Applications (never-touch)."
    },
    {
      "id": "macos-diskimages-support",
      "name": "DiskImages Application Support cache",
      "category": "caches",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Application Support/DiskImages"
      ],
      "delete_mode": "contents",
      "max_depth": 4,
      "notes": "Mount/cache metadata for disk images; not the .dmg files in Downloads."
    },
    {
      "id": "macos-orphaned-app-support-report",
      "name": "Orphaned Application Support after uninstall (report-only)",
      "category": "leftovers",
      "risk": "report-only",
      "report_only": true,
      "default_enabled": false,
      "min_age_days": 0,
      "paths": [
        "$HOME/Library/Application Support",
        "$HOME/Library/Caches",
        "$HOME/Library/Preferences",
        "$HOME/Library/Saved Application State",
        "$HOME/Library/Containers",
        "$HOME/Library/Group Containers",
        "$HOME/Library/HTTPStorages",
        "$HOME/Library/WebKit",
        "$HOME/Library/Logs"
      ],
      "delete_mode": "path",
      "max_depth": 2,
      "notes": "Pattern inventory only: compare bundle IDs / folder names to installed apps. Never bulk-delete Application Support. Heuristic leftover detection is post-MVP."
    },
    {
      "id": "macos-saved-state-aged",
      "name": "Saved Application State (aged)",
      "category": "leftovers",
      "risk": "low",
      "report_only": false,
      "default_enabled": true,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Saved Application State"
      ],
      "delete_mode": "contents",
      "max_depth": 4,
      "notes": "Window resume state; apps recreate. Overlaps core macos pack; listed for misc completeness."
    },
    {
      "id": "macos-autosave-information",
      "name": "Autosave Information leftovers",
      "category": "leftovers",
      "risk": "medium",
      "report_only": false,
      "default_enabled": false,
      "min_age_days": 30,
      "paths": [
        "$HOME/Library/Autosave Information"
      ],
      "delete_mode": "contents",
      "max_depth": 3,
      "notes": "May contain unsaved document drafts. Medium risk; long age floor."
    },
    {
      "id": "macos-icloud-offline-files-report",
      "name": "iCloud local offline / evictable files (report-only)",
      "category": "icloud",
      "risk": "report-only",
      "report_only": true,
      "default_enabled": false,
      "min_age_days": 0,
      "paths": [
