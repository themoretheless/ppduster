      "risk": "low",
      "default_enabled": true,
      "min_age_days": 3,
      "report_only": false,
      "delete_mode": "contents",
      "max_depth": 6,
      "paths": [
        "$HOME/Library/Application Support/Steam/appcache/httpcache",
        "$HOME/Library/Application Support/Steam/appcache/librarycache",
        "$HOME/Library/Application Support/Steam/appcache/stats"
      ],
      "notes": "Verified on host: appcache/{httpcache,librarycache,stats}. Leave appinfo.vdf/packageinfo.vdf if present (regenerable but small)."
