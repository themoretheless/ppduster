{
  "batch": "06-gaming",
  "platform": "macos",
  "scope": "Gaming launchers, clients, Wine/GPTK layers, media players, and entertainment app caches/logs/temp under $HOME only. Never whole game installs, libraries, or save files. Large incomplete download trees are report_only.",
  "safety_notes": [
    "Do not wipe steamapps/common, Epic/GOG/itch installed games, Minecraft saves/resource packs, OpenEmu ROM library or battery saves, bottle roots, Music/TV media libraries, or userdata save trees.",
    "Steam: clean appcache/depotcache/logs/shadercache/temp only; leave config, userdata, and common installs.",
    "Whisky/CrossOver: clean bottle Temp/shader/logs only, never entire Bottles directories.",
    "Valorant has no native Mac client; only Wine/bottle temp caches if present.",
    "Spotify PersistentCache/Storage can hold offline downloads; regenerable but large — keep min_age and contents-only.",
    "Battle.net/Riot install roots often live under /Users/Shared (outside $HOME); only $HOME Library paths listed here.",
    "report_only for large in-progress download folders (steamapps/downloading, itch downloads, Heroic/GOG/Epic incomplete installs)."
  ],
  "sources": [
    "mac-cleanup-sh Steam/Minecraft/Lunar modules",
    "Epic official launcher cache FAQ (webcache under ~/Library/Caches/com.epicgames.EpicGamesLauncher)",
    "Whisky docs paths (Containers Bottles, Logs, Application Support Libraries)",
    "Unity docs UPM global cache ~/Library/Caches/Unity/upm",
    "Plex support Plug-in Support/Caches + PhotoTranscoder",
    "Apple GPTK D3DMetal shader cache under DARWIN_USER_CACHE_DIR/d3dm",
    "Local machine verification: Steam appcache/logs/steamapps layout under this user"
  ],
  "path_count": 194,
  "rules": [
    {
      "id": "mac-steam-appcache",
      "name": "Steam appcache (HTTP/library metadata)",
