{
  "batch": "27-backup-sync",
  "platform_focus": "macos",
  "description": "Backup and sync client CACHES and LOGS only under $HOME (plus a few user-visible system log roots when apps install there). Never delete backup destinations, cloned volumes, Time Machine destinations, SafetyNet archives, synced user trees, or CloudStorage content. Time Machine local snapshots and full backup-plan metadata are report-only. Prefer contents-only deletes, age gates, and native cleaners (restic cache --cleanup, Arq Clear Cache, kopia cache clear) when available.",
  "scope": "Caches/logs for Arq, Carbon Copy Cloner, SuperDuper, Backblaze, CrashPlan, Time Machine (report-only), Resilio Sync, Syncthing, Nextcloud, ownCloud, Seafile, Transmit, Cyberduck, FileZilla, Panic Nova residual, ForkLift, Path Finder, Mountain Duck, ExpanDrive, rclone, restic, borg, kopia, duplicacy. Never backup destinations.",
  "path_count": 184,
  "safety": {
    "backup_destinations": "never-touch (report-only if surfaced)",
    "time_machine_local_snapshots": "report-only (tmutil only)",
    "synced_user_folders": "never-touch",
    "cloudstorage_file_provider": "never-touch",
    "credentials_keys": "never-touch (excluded)"
  },
  "rules": [
    {
      "id": "backup-arq-cache",
      "name": "Arq backup metadata cache",
      "description": "Arq local object/metadata cache (Cache.noindex). Regenerable from storage; next backup rebuilds slowly.",
      "category": "app-cache",
      "platform": "macos",
      "risk": "medium",
      "default_enabled": false,
      "min_age_days": 14,
      "paths": [
        "$HOME/Library/Arq/Cache.noindex",
        "$HOME/Library/Application Support/ArqAgent/cache.noindex",
        "/Library/Application Support/ArqAgent/cache.noindex",
        "$HOME/Library/Caches/com.haystacksoftware.Arq",
        "$HOME/Library/Caches/com.haystacksoftware.ArqAgent"
      ],
      "include_globs": [],
      "exclude_globs": [],
      "delete_mode": "contents",
      "max_depth": 6,
      "report_only": false,
      "native_hints": [
        "Arq menu: Clear Cache for the backup plan"
      ],
      "notes": "Prefer in-app Clear Cache. Never touch backup destinations or storage credentials under Application Support/Arq plan configs."
    },
    {
      "id": "backup-arq-logs",
      "name": "Arq agent and app logs",
      "description": "ArqAgent and Arq UI log directories only.",
