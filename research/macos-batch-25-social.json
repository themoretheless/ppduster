{
  "batch": "25-social",
  "platform_focus": "macos",
  "description": "Social/media and multi-messenger desktop app CACHES and LOGS under $HOME on macOS. Focus: Twitter/X legacy and Tweetbot, Mastodon desktop (Whalebird; Ivory is iOS-only), web-first clients (Elk/Phanpy noted), LinkedIn/Instagram/TikTok/Threads/Reddit desktop or iPad-on-Mac container caches, Discord channel residuals, Caprine/Franz/Rambox/Station residuals, Beeper/Texts, Pidgin/Adium logs and icon caches, Element residuals, Session, Briar, Threema, Wire. Chromium Electron subdirs only (Cache, Code Cache, GPUCache, Dawn*, Service Worker, blob_storage, Crashpad, logs). Never message DBs, Local Storage, IndexedDB, Cookies, Preferences, sql/, attachments, or account key material.",
  "scope": "Caches/logs residual for social desktop Electron and classic IM shells. Batch-05/apps-comms already cover base Discord/Element Caprine Franz Rambox Station trios; this batch adds channel extras, ShipIt/Library Caches/Logs, multi-service partition caches, and messengers not covered there.",
  "never_touch_notes": [
    "Never wipe whole Application Support/<App> trees (holds login/session/IndexedDB)",
    "Never Session/Signal-style sql or attachments stores",
    "Never BeeperTexts/Beeper index.db or encrypted message stores (cache subdirs only)",
    "Never Wire config/ under Application Support (logs/Cache only)",
    "Never Adium/Pidgin account plists or keychains; chat transcript rules are medium/default off",
    "Ivory is iOS-only; do not invent macOS Ivory paths",
    "Elk/Phanpy are primarily web/PWA; browser profile caches stay in browser batches"
  ],
  "path_count": 270,
  "rules": [
    {
      "id": "social-twitter-x-legacy-cache",
      "name": "Twitter for Mac and Tweetbot caches",
      "description": "Legacy official Twitter for Mac container image caches plus Tweetbot Mac series Library/Caches. Not credentials or Core Data timelines as whole-container wipes.",
      "category": "app-cache",
      "platform": "macos",
      "risk": "low",
      "default_enabled": true,
      "min_age_days": 7,
      "paths": [
        "$HOME/Library/Containers/com.twitter.twitter-mac/Data/Library/Caches",
        "$HOME/Library/Caches/com.twitter.twitter-mac",
        "$HOME/Library/Caches/74b320c6.com.twitter.twitter-mac",
        "$HOME/Library/Containers/com.tapbots.TweetbotMac/Data/Library/Caches",
        "$HOME/Library/Containers/com.tapbots.Tweetbot2Mac/Data/Library/Caches",
        "$HOME/Library/Containers/com.tapbots.Tweetbot3Mac/Data/Library/Caches",
        "$HOME/Library/Caches/com.tapbots.TweetbotMac",
        "$HOME/Library/Caches/com.tapbots.Tweetbot2Mac",
        "$HOME/Library/Caches/com.tapbots.Tweetbot3Mac",
        "$HOME/Library/Logs/Twitter",
        "$HOME/Library/Logs/Tweetbot"
      ],
      "include_globs": [],
      "exclude_globs": [],
      "delete_mode": "contents",
      "max_depth": 6,
      "report_only": false,
      "notes": "Official Twitter for Mac was discontinued; leftover containers can still hold large profile-image caches. X has no first-party Electron desktop path beyond web/PWA."
    },
